<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup and device-transfer rules: never copy
     architecture-specific extracted binaries or staging .part files
     across devices (e.g. 32-bit phone -> 64-bit-only phone). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="runtime" />
        <exclude domain="file" path="staging" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="runtime" />
        <exclude domain="file" path="staging" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graball_bg"
    android:orientation="vertical">

    <!-- Video Player Container (expands to match_parent in Fullscreen & PiP) -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="225dp"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/ytPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:surface_type="surface_view"
            app:use_controller="true" />

        <!-- Audio-only placeholder banner (positioned near top & non-clickable so
             it never overlaps ExoPlayer's center Play/Pause/Prev/Next controls) -->
        <TextView
            android:id="@+id/audioOnlyBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="48dp"
            android:background="@drawable/yt_hud_bg"
            android:clickable="false"
            android:focusable="false"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="🎧 Audio-Only Mode (Battery Saver)"
            android:textColor="@color/graball_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Gesture & SponsorBlock HUD -->
        <TextView
            android:id="@+id/gestureHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/yt_hud_bg"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/graball_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/playerLoadingBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/playerLoading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/graball_orange" />

            <TextView
                android:id="@+id/playerLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/yt_hud_bg"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Connecting…"
                android:textColor="@color/graball_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Top Quick Overlay Bar (Back / CC / Quality / PiP / Fullscreen — auto-hides with controls) -->
        <LinearLayout
            android:id="@+id/playerTopOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnPlayerBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/yt_badge_bg"
                android:gravity="center"
                android:text="↓"
                android:textColor="@color/graball_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnTopCaptions"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/yt_badge_bg"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="CC"
                android:textColor="@color/graball_subtext"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTopQuality"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/yt_badge_bg"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="⚙ Auto"
                android:textColor="@color/graball_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTopAspect"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/yt_badge_bg"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Fit"
                android:textColor="@color/graball_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnTopPip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/yt_badge_bg"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="PiP"
                android:textColor="@color/graball_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFullscreen"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:background="@drawable/yt_badge_bg"
                android:gravity="center"
                android:text="⛶"
                android:textColor="@color/graball_text"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Details + NewPipe Action Strip + Related Videos (hidden in PiP / Fullscreen) -->
    <LinearLayout
        android:id="@+id/detailsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Video Title, Expandable Description & Meta -->
        <LinearLayout
            android:id="@+id/playerTitleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playerVideoTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Loading…"
                    android:textColor="@color/graball_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playerDescChevron"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="⌄"
                    android:textColor="@color/graball_subtext"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/playerVideoMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/graball_subtext"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/playerDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/card_bg"
                android:maxLines="8"
                android:ellipsize="end"
                android:padding="10dp"
                android:textColor="@color/graball_subtext"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/playerErrorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/playerError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FF6B6B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnPlayerRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/yt_chip_selected"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="↻ Retry"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dedicated Channel Row (Tap Channel -> Go to Channel Page; Right -> Subscribe) -->
        <LinearLayout
            android:id="@+id/playerChannelRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/playerChannelInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/playerChannelAvatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/yt_chip_bg"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playerChannelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Channel"
                        android:textColor="@color/graball_text"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/playerChannelSubs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="View channel ›"
                        android:textColor="@color/graball_subtext"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/actionSubscribe"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/yt_chip_selected"
                android:gravity="center"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="🔔 Subscribe"
                android:textColor="@color/graball_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Action Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/actionDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/yt_chip_selected"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="⬇ Download"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/actionBgAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🎧 Audio"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/actionLike"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="👍 Like"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/actionSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="1.0×"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/actionBookmark"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="☆ Save"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/actionSponsorBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="SB: ON"
                    android:textColor="@color/graball_active"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/actionOpenWeb"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🌐 Web"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Inline Comments Preview Card (Tap -> Full Comments Bottom Sheet) -->
        <LinearLayout
            android:id="@+id/playerCommentsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/actionComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 Comments"
                android:textColor="@color/graball_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playerCommentsPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to view comments"
                android:textColor="@color/graball_subtext"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Up Next Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="Up Next"
            android:textColor="@color/graball_subtext"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/relatedList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (real since v0.5.9): the YouTube session import lives
     here now, not on the main screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graball_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <Button
        android:id="@+id/settingsBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_small"
        android:text="@string/settings_back"
        android:textColor="@color/graball_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/settings_title"
        android:textColor="@color/graball_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_session"
            android:textColor="@color/graball_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_session_help"
            android:textColor="@color/graball_subtext"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/settingsCookiesStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cookies_missing"
            android:textColor="@color/graball_subtext"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settingsImportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_orange"
            android:text="@string/import_cookies"
            android:textColor="@color/graball_text"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

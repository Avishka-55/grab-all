<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (real since v0.5.9): the YouTube session import lives
     here now, not on the main screen. Same footer as everywhere:
     Grab, Downloads, Settings. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graball_bg">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/settingsBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_small"
                android:text="@string/settings_back"
                android:textColor="@color/graball_text"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/graball_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_session"
                    android:textColor="@color/graball_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_session_help"
                    android:textColor="@color/graball_subtext"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/settingsCookiesStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cookies_missing"
                    android:textColor="@color/graball_subtext"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/settingsLoginButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/btn_orange"
                    android:text="@string/login_youtube"
                    android:textColor="@color/graball_text"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settingsLogoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_small"
                    android:text="@string/logout_youtube"
                    android:textColor="@color/graball_text"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- YouTube Player & Cache Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube Player &amp; Cache"
                    android:textColor="@color/graball_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/settingsScreenOffAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Switch to audio-only when screen turns off (saves battery &amp; data)"
                    android:textColor="@color/graball_text"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/settingsSponsorBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="SponsorBlock: auto-skip in-video sponsors &amp; intros"
                    android:textColor="@color/graball_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/settingsCacheSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cache: 0 MB"
                    android:textColor="@color/graball_subtext"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/settingsClearCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_small"
                    android:text="Clear Player &amp; Thumbnail Cache"
                    android:textColor="@color/graball_text" />
            </LinearLayout>

            <!-- Download Speed & Concurrent Downloads -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download Speed &amp; Concurrency"
                    android:textColor="@color/graball_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settingsConcurrencyHelp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Simultaneous playlist tracks &amp; concurrent video downloads. Higher values finish 100+ playlists much faster on fast Wi-Fi."
                    android:textColor="@color/graball_subtext"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/settingsConcurrencyChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipConcAuto"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1.3"
                        android:background="@drawable/yt_chip_selected"
                        android:gravity="center"
                        android:text="Auto"
                        android:textColor="@color/graball_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipConc1"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/yt_chip_bg"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/graball_subtext"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipConc2"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/yt_chip_bg"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/graball_subtext"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipConc3"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/yt_chip_bg"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/graball_subtext"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipConc4"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/yt_chip_bg"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="@color/graball_subtext"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipConc6"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/yt_chip_bg"
                        android:gravity="center"
                        android:text="6"
                        android:textColor="@color/graball_subtext"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/settingsConcurrencyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/graball_orange"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Audio Download Format"
                    android:textColor="@color/graball_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAudioM4a"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/yt_chip_selected"
                        android:gravity="center"
                        android:text="M4A (Fast · Default)"
                        android:textColor="@color/graball_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipAudioMp3"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/yt_chip_bg"
                        android:gravity="center"
                        android:text="MP3 (Universal)"
                        android:textColor="@color/graball_subtext"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/settingsAudioFormatStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/graball_subtext"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- yt-dlp Engine Self-Updater -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="yt-dlp Engine"
                    android:textColor="@color/graball_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Updates directly from the official yt-dlp GitHub repository to keep YouTube downloads and playback working without reinstalling the app."
                    android:textColor="@color/graball_subtext"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/settingsYtDlpVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Active: 2026.10.26 (bundled)"
                    android:textColor="@color/graball_text"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/settingsYtDlpNightly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Use Nightly channel (fastest YouTube fixes)"
                    android:textColor="@color/graball_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/settingsYtDlpStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/graball_orange"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/settingsYtDlpUpdate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/btn_orange"
                        android:text="Update yt-dlp"
                        android:textColor="@color/graball_text"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/settingsYtDlpReset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_small"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Reset"
                        android:textColor="@color/graball_text"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- GrabAll App Update Checker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GrabAll App Updates"
                    android:textColor="@color/graball_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settingsAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Installed version"
                    android:textColor="@color/graball_subtext"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/settingsAppUpdateStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/graball_orange"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/settingsCheckAppUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_small"
                    android:text="Check for App Update"
                    android:textColor="@color/graball_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

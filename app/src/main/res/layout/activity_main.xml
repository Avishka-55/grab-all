<?xml version="1.0" encoding="utf-8"?>
<!-- Single-Activity shell hosting Grab, Music, Downloads & Settings as cached
     Fragments above ONE rock-solid pinned Material 3 bottom navigation bar. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graball_bg">

    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/graball_nav"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Grab Tab -->
        <LinearLayout
            android:id="@+id/navGrab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/navGrabPill"
                    android:layout_width="56dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/nav_pill_active" />

                <ImageView
                    android:id="@+id/navGrabIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_grab"
                    android:tint="@color/graball_orange" />
            </FrameLayout>

            <TextView
                android:id="@+id/navGrabLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_grab"
                android:textColor="@color/graball_orange"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Music Tab -->
        <LinearLayout
            android:id="@+id/navPlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/navPlayerPill"
                    android:layout_width="56dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/nav_pill_active" />

                <ImageView
                    android:id="@+id/navPlayerIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_player"
                    android:tint="@color/graball_tab_text" />
            </FrameLayout>

            <TextView
                android:id="@+id/navPlayerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_player"
                android:textColor="@color/graball_tab_text"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Downloads Tab -->
        <LinearLayout
            android:id="@+id/navDownloads"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/navDownloadsPill"
                    android:layout_width="56dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/nav_pill_active" />

                <ImageView
                    android:id="@+id/navDownloadsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_downloads"
                    android:tint="@color/graball_tab_text" />
            </FrameLayout>

            <TextView
                android:id="@+id/navDownloadsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_downloads"
                android:textColor="@color/graball_tab_text"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Settings Tab -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/navSettingsPill"
                    android:layout_width="56dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/nav_pill_active" />

                <ImageView
                    android:id="@+id/navSettingsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_settings"
                    android:tint="@color/graball_tab_text" />

                <View
                    android:id="@+id/navSettingsDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="13dp"
                    android:background="@drawable/settings_update_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/navSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_settings"
                android:textColor="@color/graball_tab_text"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

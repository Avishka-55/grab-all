<?xml version="1.0" encoding="utf-8"?>
<!-- Modern folder-aware Music Player: browse by music folder across internal
     storage & SD card (voice notes / call recordings auto-hidden), search,
     folder-scoped playback, shuffle/repeat, and modern now-playing card. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graball_bg">

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/graball_nav"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navGrab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_add"
                android:tint="@color/graball_tab_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_grab"
                android:textColor="@color/graball_tab_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navDownloads"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/stat_sys_download"
                android:tint="@color/graball_tab_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_downloads"
                android:textColor="@color/graball_tab_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/graball_orange" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_player"
                android:textColor="@color/graball_orange"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="@color/graball_tab_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_settings"
                android:textColor="@color/graball_tab_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header Row: Title + Folder Filter Manager -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playerHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/player_title"
                android:textColor="@color/graball_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnManageFolders"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/yt_chip_bg"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="⚙ Filter Folders"
                android:textColor="@color/graball_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Search Input -->
        <EditText
            android:id="@+id/playerSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_bg"
            android:hint="Search folders or songs…"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/graball_text"
            android:textColorHint="@color/graball_tab_text"
            android:textSize="13sp" />

        <!-- Tabs: Folders | All Music (+ Folder Breadcrumb Bar when inside a folder) -->
        <LinearLayout
            android:id="@+id/playerTabsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabMusicFolders"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/yt_chip_selected"
                android:gravity="center"
                android:text="📁 Folders"
                android:textColor="@color/graball_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabMusicAll"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/yt_chip_bg"
                android:gravity="center"
                android:text="🎵 All Music"
                android:textColor="@color/graball_subtext"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Folder Header when browsing inside a specific folder -->
        <LinearLayout
            android:id="@+id/folderHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnFolderBack"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/yt_chip_bg"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="← Folders"
                android:textColor="@color/graball_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/folderHeaderName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/graball_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFolderPlayAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/yt_chip_selected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="▶ Play"
                android:textColor="@color/graball_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main RecyclerView + Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playerRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/playerEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/player_empty"
                android:textColor="@color/graball_subtext"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Modern Now-Playing Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/yt_chip_selected"
                    android:gravity="center"
                    android:text="♫"
                    android:textColor="@color/graball_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playerNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/player_tap_to_play"
                        android:textColor="@color/graball_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/playerNowFolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Voice notes &amp; call recordings auto-hidden"
                        android:textColor="@color/graball_subtext"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/playerStop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:text="⏹"
                    android:textColor="@color/graball_subtext"
                    android:textSize="13sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/playerSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/playerTimeCur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="@color/graball_subtext"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/playerTimeDur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/graball_subtext"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playerShuffle"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:text="🔀"
                    android:textColor="@color/graball_subtext"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/playerPrev"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:text="⏮"
                    android:textColor="@color/graball_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/playerPlayPause"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/yt_chip_selected"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/graball_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playerNext"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:text="⏭"
                    android:textColor="@color/graball_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/playerRepeat"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="@drawable/yt_chip_selected"
                    android:gravity="center"
                    android:text="🔁"
                    android:textColor="@color/graball_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

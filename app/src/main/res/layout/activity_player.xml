<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Music Player:
     - Library tabs: All Music (default) | Folders | Playlists
     - Bottom nav: Grab | Music | Downloads | Settings
     - Compact expandable Mini-Player bar
     - Full-bleed Dynamic Album-Art Now Playing UI with mirrored AudioWaveView
     - Full-Screen Live Synced Lyrics with dynamic album-color backdrop -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graball_bg">

    <!-- Main Library + Compact Mini-Player + Bottom Nav -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/graball_nav"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/navGrab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_add"
                    android:tint="@color/graball_tab_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_grab"
                    android:textColor="@color/graball_tab_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPlayer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@color/graball_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_player"
                    android:textColor="@color/graball_orange"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navDownloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/stat_sys_download"
                    android:tint="@color/graball_tab_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_downloads"
                    android:textColor="@color/graball_tab_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    android:tint="@color/graball_tab_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_settings"
                    android:textColor="@color/graball_tab_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomNav"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Header Row: Title + Equalizer + Folder Filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playerHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/player_title"
                    android:textColor="@color/graball_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnEqualizer"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🎚 EQ"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnManageFolders"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="⚙ Filter"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Search Input -->
            <EditText
                android:id="@+id/playerSearch"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_bg"
                android:hint="Search songs, folders or playlists…"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/graball_text"
                android:textColorHint="@color/graball_tab_text"
                android:textSize="13sp" />

            <!-- Tabs: All Music (Default) | Folders | Playlists -->
            <LinearLayout
                android:id="@+id/playerTabsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabMusicAll"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/yt_chip_selected"
                    android:gravity="center"
                    android:text="🎵 All Music"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabMusicFolders"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:text="📁 Folders"
                    android:textColor="@color/graball_subtext"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabMusicPlaylists"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:text="📋 Playlists"
                    android:textColor="@color/graball_subtext"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- New Playlist Action Bar (visible only in Playlists tab) -->
            <TextView
                android:id="@+id/btnNewPlaylist"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/yt_chip_bg"
                android:gravity="center"
                android:text="+ New Playlist"
                android:textColor="@color/graball_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Folder / Playlist Breadcrumb Bar -->
            <LinearLayout
                android:id="@+id/folderHeaderBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnFolderBack"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="← Folders"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/folderHeaderName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/graball_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnFolderPlayAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/yt_chip_selected"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="▶ Play"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Main RecyclerView + Empty State -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/playerRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="6dp" />

                <LinearLayout
                    android:id="@+id/playerEmptyBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/playerEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/player_empty"
                        android:textColor="@color/graball_subtext"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnSearchOnYoutube"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/yt_chip_selected"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="🔍 Search on YouTube ↗"
                        android:textColor="@color/graball_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- Compact Expandable Mini-Player Bar -->
            <LinearLayout
                android:id="@+id/miniPlayerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/card_bg"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="10dp">

                <ProgressBar
                    android:id="@+id/miniProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginBottom="8dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="@color/graball_orange"
                    android:progressBackgroundTint="@color/graball_stroke" />

                <LinearLayout
                    android:id="@+id/miniYtBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎧 YouTube Audio Playing"
                        android:textColor="@color/graball_orange"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/miniBtnOpenYoutube"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/yt_chip_selected"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="📺 Watch Video ↗"
                        android:textColor="@color/graball_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/miniPlayerRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/miniArtBox"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/album_art_bg">

                        <ImageView
                            android:id="@+id/miniArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/miniArtFallback"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="♫"
                            android:textColor="@color/graball_orange"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/miniTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/player_tap_to_play"
                            android:textColor="@color/graball_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/miniSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Tap to open player · Voice notes hidden"
                            android:textColor="@color/graball_subtext"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/miniPlayPause"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/play_circle_bg"
                        android:contentDescription="Play or pause"
                        android:padding="9dp"
                        android:src="@drawable/ic_media_play_white" />

                    <ImageView
                        android:id="@+id/miniNext"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/yt_chip_bg"
                        android:contentDescription="Next song"
                        android:padding="8dp"
                        android:src="@drawable/ic_media_next_white" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Full-Screen Dynamic Album-Art Now Playing Overlay (Immersive Edge-to-Edge) -->
    <LinearLayout
        android:id="@+id/nowPlayingSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A172B"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Half: Full-Bleed Edge-to-Edge Album Cover + Gradient Melt + Sound Wave -->
        <FrameLayout
            android:id="@+id/npArtBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.08">

            <ImageView
                android:id="@+id/npArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/npArtFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="♫"
                android:textColor="#44FFFFFF"
                android:textSize="96sp"
                android:textStyle="bold" />

            <!-- Smooth bottom melt from full-bleed cover into dynamic album color -->
            <View
                android:id="@+id/npArtFade"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_gravity="bottom" />

            <!-- Mirrored Translucent Sound Wave Horizon (Option A, 0 permissions) -->
            <com.graball.AudioWaveView
                android:id="@+id/npWave"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_gravity="bottom" />

            <!-- Floating Translucent Top Bar -->
            <LinearLayout
                android:id="@+id/npTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/npCollapse"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_translucent_bg"
                    android:contentDescription="Collapse player"
                    android:padding="8dp"
                    android:src="@drawable/ic_chevron_down_white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/npSourceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pill_translucent_bg"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="NOW PLAYING"
                        android:textColor="#E6FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/npBtnQueue"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_translucent_bg"
                    android:contentDescription="Up next queue"
                    android:padding="9dp"
                    android:src="@drawable/ic_queue_white" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom Half: Dynamic Color Control Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="6dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <!-- Song Title & Artist / Channel -->
            <TextView
                android:id="@+id/npTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/player_tap_to_play"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/npArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <!-- YouTube Audio Direct Jump Pill (shown only in YouTube Audio Mode) -->
            <LinearLayout
                android:id="@+id/npYoutubeBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/npBtnOpenYoutube"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/pill_translucent_bg"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="📺 Watch Video on YouTube ↗"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Action Pills Strip: Lyrics · EQ · Playlist / Download · Stop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/npBtnLyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/pill_translucent_bg"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="🎤 Lyrics"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/npBtnEq"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/pill_translucent_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🎚 EQ"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/npBtnAddPlaylist"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/pill_translucent_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="➕ Playlist"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/npBtnDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/pill_translucent_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="⬇ Save"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/npBtnStop"
                    android:layout_width="36dp"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_translucent_bg"
                    android:contentDescription="Stop playback"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_stop_white" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.8" />

            <!-- Inline SeekBar Row: 00:04 ──●── 03:29 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/npTimeCur"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="0:00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/npSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="#FFFFFF"
                    android:progressBackgroundTint="#44FFFFFF"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/npTimeDur"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Minimalist Pure-White Transport Controls (zero emoji boxes, no circle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/npShuffle"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Shuffle"
                    android:padding="9dp"
                    android:src="@drawable/ic_media_shuffle_white" />

                <ImageView
                    android:id="@+id/npPrev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Previous song"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_prev_white" />

                <ImageView
                    android:id="@+id/npPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play or pause"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_play_white" />

                <ImageView
                    android:id="@+id/npNext"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Next song"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_next_white" />

                <ImageView
                    android:id="@+id/npRepeat"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Repeat mode"
                    android:padding="9dp"
                    android:src="@drawable/ic_media_repeat_white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Full-Screen Spotify / YouTube Music Style Live Lyrics View (Dynamic Color Backdrop) -->
    <LinearLayout
        android:id="@+id/lyricsSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#131120"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Compact Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#33000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/lyricsClose"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/circle_translucent_bg"
                android:contentDescription="Close lyrics"
                android:padding="7dp"
                android:src="@drawable/ic_chevron_down_white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lyricsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lyricsSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyricsSyncRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lyricsSyncMinus"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:background="@drawable/pill_translucent_bg"
                    android:gravity="center"
                    android:text="-½s"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/lyricsSyncPlus"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/pill_translucent_bg"
                    android:gravity="center"
                    android:text="+½s"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacious Full-Height Live Lyrics List -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lyricsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingTop="120dp"
                android:paddingEnd="20dp"
                android:paddingBottom="160dp" />

            <LinearLayout
                android:id="@+id/lyricsStatusBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/lyricsSpinner"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <TextView
                    android:id="@+id/lyricsStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Finding synced lyrics…"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Compact Spotify-Style Bottom Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#33000000"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <SeekBar
                android:id="@+id/lyricsSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#44FFFFFF"
                android:thumbTint="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/lyricsTimeCur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/lyricsTimeDur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lyricsBtnOpenYoutube"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/pill_translucent_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="📺 Video"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/lyricsPrev"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous song"
                        android:padding="8dp"
                        android:src="@drawable/ic_media_prev_white" />

                    <ImageView
                        android:id="@+id/lyricsPlayPause"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Play or pause"
                        android:padding="7dp"
                        android:src="@drawable/ic_media_play_white" />

                    <ImageView
                        android:id="@+id/lyricsNext"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next song"
                        android:padding="8dp"
                        android:src="@drawable/ic_media_next_white" />
                </LinearLayout>

                <View
                    android:layout_width="68dp"
                    android:layout_height="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

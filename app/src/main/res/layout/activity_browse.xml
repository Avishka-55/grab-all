<?xml version="1.0" encoding="utf-8"?>
<!-- Browser: the download bar is gone. A small Grab button floats
     over the page (bright when the open page is downloadable, dim
     when it is not); tapping it opens the panel, which grabs the
     live address itself. The panel hides again on Close, so the
     button never fights YouTube's own bottom bar for long. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/browseWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/browseFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:alpha="0.5"
        android:text="@string/grab" />

    <LinearLayout
        android:id="@+id/browsePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?attr/colorBackground"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/browseLinkPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/browseClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_close" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/browseOptionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/browseQuality"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <CheckBox
                android:id="@+id/browseAudioOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audio_only" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/browsePlaylistRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/browsePlaylist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/browseRefreshLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refresh_link" />

            <Button
                android:id="@+id/browseReload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_reload" />

            <Button
                android:id="@+id/browseDownload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/download" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Sleek WhatsApp Status tile: rounded thumbnail + video badge + compact Save pill -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/statusThumbBox"
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:background="#12121A">

        <ImageView
            android:id="@+id/statusThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Subtle Play badge shown only on video statuses -->
        <TextView
            android:id="@+id/statusVideoBadge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_translucent_bg"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/statusSave"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/yt_chip_bg"
        android:gravity="center"
        android:text="⬇ Save"
        android:textColor="@color/graball_text"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>

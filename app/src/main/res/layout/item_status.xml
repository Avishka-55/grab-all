<?xml version="1.0" encoding="utf-8"?>
<!-- One status in the grid: thumbnail on top, Save button below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/statusThumb"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="centerCrop" />

    <Button
        android:id="@+id/statusSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_small"
        android:text="@string/status_save"
        android:textColor="@color/graball_text" />

</LinearLayout>

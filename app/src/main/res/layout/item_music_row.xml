<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/musicRowIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/yt_chip_bg"
        android:gravity="center"
        android:text="🎵"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/musicRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/graball_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/musicRowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/graball_subtext"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/musicRowAction"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/yt_chip_bg"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="▶"
        android:textColor="@color/graball_orange"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>

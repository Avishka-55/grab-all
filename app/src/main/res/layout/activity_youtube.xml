<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graball_bg"
    android:orientation="vertical">

    <!-- Top Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/graball_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/ytBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/graball_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/ytSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search YouTube (ad-free)…"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/graball_text"
                android:textColorHint="@color/graball_tab_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ytSearchClear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/graball_subtext"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ytSearchGo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/yt_chip_selected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Go"
                android:textColor="@color/graball_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Section Tabs (Explore / Bookmarks / History / Queue) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/graball_nav"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/ytTabExplore"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/yt_chip_selected"
            android:gravity="center"
            android:text="Explore"
            android:textColor="@color/graball_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ytTabBookmarks"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/yt_chip_bg"
            android:gravity="center"
            android:text="Saved"
            android:textColor="@color/graball_subtext"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ytTabHistory"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/yt_chip_bg"
            android:gravity="center"
            android:text="History"
            android:textColor="@color/graball_subtext"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ytTabQueue"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/yt_chip_bg"
            android:gravity="center"
            android:text="Queue"
            android:textColor="@color/graball_subtext"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Search Filter Chips (All / Videos / Playlists / Music) -->
    <HorizontalScrollView
        android:id="@+id/ytFilterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/yt_chip_selected"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="All"
                android:textColor="@color/graball_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipVideos"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/yt_chip_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Videos"
                android:textColor="@color/graball_subtext"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipPlaylists"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/yt_chip_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Playlists"
                android:textColor="@color/graball_subtext"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipMusic"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/yt_chip_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Music"
                android:textColor="@color/graball_subtext"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Playlist Header Banner (visible when browsing inside a playlist) -->
    <LinearLayout
        android:id="@+id/ytPlaylistBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ytPlaylistTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/graball_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ytPlaylistMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/graball_subtext"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ytPlaylistPlayAll"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/yt_chip_bg"
                android:gravity="center"
                android:text="▶ Play All"
                android:textColor="@color/graball_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ytPlaylistDownload"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/yt_chip_selected"
                android:gravity="center"
                android:text="⬇ Download All"
                android:textColor="@color/graball_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ytPlaylistClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/yt_chip_bg"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/graball_subtext"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main List Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ytList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp" />

        <ProgressBar
            android:id="@+id/ytLoading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/graball_orange"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ytEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Search YouTube or pick a video to play ad-free"
            android:textColor="@color/graball_subtext"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- In-app Mini-Player Bar (works on Android 5 through Android 16) -->
    <LinearLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#1D1D30"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/miniThumb"
            android:layout_width="64dp"
            android:layout_height="42dp"
            android:background="#000000"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/graball_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/graball_orange"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/miniPlayPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⏸"
            android:textColor="@color/graball_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/miniNext"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⏭"
            android:textColor="@color/graball_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/miniClose"
            android:layout_width="34dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/graball_subtext"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graball_bg">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <!-- Header row: Title + live count + Clear Done action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_downloads"
                        android:textColor="@color/graball_text"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/downloadsCountSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Saved in Downloads/GrabAll"
                        android:textColor="@color/graball_subtext"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClearCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/yt_chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Clear Done"
                    android:textColor="@color/graball_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Filter chips: All · Active · Video · Audio -->
            <HorizontalScrollView
                android:id="@+id/downloadsFilterScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/yt_chip_selected"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="All"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/filterActive"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/yt_chip_bg"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Active"
                        android:textColor="@color/graball_text"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/filterVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/yt_chip_bg"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="🎬 Video"
                        android:textColor="@color/graball_text"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/filterAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/yt_chip_bg"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="🎵 Audio"
                        android:textColor="@color/graball_text"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Clean Empty State -->
            <LinearLayout
                android:id="@+id/downloadsEmptyBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:alpha="0.7"
                    android:src="@drawable/ic_nav_downloads"
                    android:tint="@color/graball_orange" />

                <TextView
                    android:id="@+id/downloadsEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No downloads yet"
                    android:textColor="@color/graball_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/downloadsEmptySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Paste any video link on Grab or tap Download on a YouTube video to save it here."
                    android:textColor="@color/graball_subtext"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/queueContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
